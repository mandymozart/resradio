# Sanity Configuration
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=your_dataset

# MySQL Configuration
DB_HOST=localhost
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=resradio

# Prismic Migration (required for scripts/migrate-audio-cdn.js)
# Prismic dashboard › Settings › API & Security › "Access token" (read)
PRISMIC_ACCESS_TOKEN=
# Prismic dashboard › Settings › API & Security › generate a "Permanent write token"
PRISMIC_WRITE_TOKEN=
